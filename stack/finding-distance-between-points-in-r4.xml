    <questionvariables>
      <text>simp:true;
avar:rand_with_step(2,6,1); 
bvar:-rand_with_step(1,5,2);
cvar:rand_with_step(1,7,1);
u:matrix([avar,1,bvar,2]);
v:matrix([1,0, cvar,3]);
v3:u-v;
simp:false;
ta:sqrt(ev(v3.v3,simp));
ws2:ev(u-v,simp);
ws3:sqrt(apply("+",maplist(lambda([ex], ex^2),first(args(ws2)))));</text>
    </questionvariables>
